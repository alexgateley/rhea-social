<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Kicks the "Post @RunonRhea" workflow's evening slot at 6:05 and 8:05 PM Pacific (the Mac's local time;
       this Mac is in America/Los_Angeles, the same zone as brand.json). launchd runs a missed calendar
       job at the next wake, and the workflow never posts a slot twice.
       Install (after the twice-daily branch is pushed to main, so the workflow has its slot input):
         cp launchd/com.rhea.evening.plist ~/Library/LaunchAgents/
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.rhea.evening.plist
       Test:      launchctl kickstart gui/$(id -u)/com.rhea.evening   (log: ~/Library/Logs/rhea-runonrhea.log)
       Uninstall: launchctl bootout gui/$(id -u)/com.rhea.evening -->
  <key>Label</key>
  <string>com.rhea.evening</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/alex/Desktop/rhea-social/scripts/kick-post.sh</string>
    <string>evening</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>18</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/alex/Library/Logs/rhea-runonrhea-evening.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alex/Library/Logs/rhea-runonrhea-evening.launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
