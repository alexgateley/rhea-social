<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Kicks the "Post Owner math" workflow at 7:05 and 9:05 AM Pacific (the Mac's local time; this
       Mac is in America/Los_Angeles, the same zone as brand.json). launchd runs a missed calendar
       job at the next wake, and the workflow never posts twice in a day or on a weekend.
       Before installing, replace the placeholder path below with where this repo lives, e.g.
       /Users/alex/Projects/rhea-social/scripts/kick-post.sh.
       Install: cp launchd/com.rhea.ownermath.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.rhea.ownermath.plist
       Test:    launchctl kickstart gui/$(id -u)/com.rhea.ownermath -->
  <key>Label</key>
  <string>com.rhea.ownermath</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/alex/<path-to>/rhea-social/scripts/kick-post.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/alex/Library/Logs/rhea-ownermath.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alex/Library/Logs/rhea-ownermath.launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
