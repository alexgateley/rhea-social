{
  "name": "rhea-social",
  "private": true,
  "type": "module",
  "description": "Two Reels a day for @RunonRhea (owner math, tips, myth vs fact, feature Reels): rendered here, served from GitHub Pages, published by GitHub Actions",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "contrast": "node scripts/contrast.mjs",
    "schedule": "node scripts/schedule.mjs",
    "hashtags": "node scripts/hashtags.mjs",
    "render": "node render/render.mjs",
    "relink": "node render/relink.mjs",
    "record": "node render/record-feature.mjs",
    "contact-sheet": "node render/contact-sheet.mjs",
    "probe": "node render/probe.mjs",
    "desktop": "node scripts/desktop-copy.mjs",
    "prune": "node scripts/prune.mjs",
    "publish:dry": "DRY_RUN=true node scripts/publish.mjs",
    "mark": "node scripts/publish.mjs mark",
    "check": "node scripts/publish.mjs check",
    "test": "node --test"
  },
  "devDependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "playwright-core": "^1.56.0"
  }
}
